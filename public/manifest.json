{
    "manifest_version": 3,
    "name": "YouTube Study Guard",
    "version": "1.0.0",
    "description": "A context-aware YouTube blocker for study sessions.",
    "permissions":[
        "tabs",
        "storage"
    ],
    "action":{
        "default_popup": "index.html"
    },
    "content_scripts":[
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content.js"]
        }
    ]

}