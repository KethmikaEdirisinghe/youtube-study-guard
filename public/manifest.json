{
    "manifest_version": 3,
    "name": "YouTube Study Guard",
    "version": "1.0.0",
    "description": "A context-aware YouTube blocker for study sessions.",
    "permissions":[
        "tabs",
        "storage",
        "webNavigation"
    ],
    "action":{
        "default_popup": "index.html"
    },

    "web_accessible_resources": [
    {
        "resources": ["guard.html", "assets/*"],
        "matches": ["https://www.youtube.com/*"]
    }
],
    "background":{
        "service_worker": "background.js"
    },
    "content_scripts":[
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content.js"]
        }
    ]

}